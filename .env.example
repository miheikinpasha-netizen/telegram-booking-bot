# Скопируйте этот файл в .env и заполните значения.

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=

# Часовой пояс салона
TIMEZONE=Europe/Moscow

# Необязательно: путь к базе и файлу услуг (относительно папки проекта)
# DB_PATH=bookings.sqlite3
# SERVICES_FILE=services.json

# Демо-режим: кнопка «Как это видит администратор» для всех (для портфолио)
DEMO_MODE=0

# Календарь-виджет в чате (Telegram Bot API 10.4, только личные чаты)
WIDGETS=0
